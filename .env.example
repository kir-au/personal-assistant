AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Alternative names also supported by auth.ts:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Personal Assistant MCP server
# Run with: npm run mcp:assistant
MCP_PORT=8787
MCP_GOOGLE_AUTH=true
MCP_PUBLIC_BASE_URL=
# Google accounts allowed in. If BOTH lists are empty, any verified Google account is accepted.
GOOGLE_ALLOWED_EMAILS=kirill.frolov@gmail.com
# GOOGLE_ALLOWED_DOMAINS=example.com,another.example (no leading @)

# How an unauthenticated /mcp request is rejected:
#   http-401 (default) -> HTTP 401 + WWW-Authenticate, so any spec-compliant MCP client
#                         can discover OAuth on its own.
#   in-band            -> legacy behaviour: HTTP 200 with the challenge in
#                         _meta["mcp/www_authenticate"]. Kept only for clients that never
#                         look at the HTTP status.
MCP_AUTH_CHALLENGE_MODE=http-401
# Override the Google token-verification endpoint (testing only).
# GOOGLE_USERINFO_URL=

# Machine clients (Moltis, scripts, CI) authenticate with long-lived bearer tokens
# instead of a browser login. Generate one with: openssl rand -hex 32
# Several tokens are allowed, comma-separated, so a token can be rotated without downtime.
MCP_SERVICE_TOKENS=

# Local Personal Vault folder service.
PERSONAL_VAULT_MCP_URL=http://127.0.0.1:8788/mcp
PERSONAL_VAULT_MCP_TIMEOUT_MS=5000

# Assistant-owned capture review and approved-update bridge.
DASHBOARD_BASE_URL=http://127.0.0.1:3002
CAPTURE_REVIEW_PROVIDER=codex
CAPTURE_REVIEW_TIMEOUT_MS=20000
# CAPTURE_REVIEW_CODEX_MODEL=
# CODEX_BIN=
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
